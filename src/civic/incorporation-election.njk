  @media(max-width:1080px){.e-layout{grid-template-columns:minmax(0,1fr)}.e-resource-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:28px}.e-resource-links li{border-bottom:1px solid var(--e-line)}.e-resource-links li+li{border-top:0}}
  @media(max-width:680px){.n-civic #main .n-wrap{padding-inline:20px}.e-heading{display:block}.n-civic #main .e-primary{margin-top:16px}.e-hero{padding-top:16px;padding-bottom:14px}.e-essentials{grid-template-columns:1fr 1fr;margin-top:18px}.e-essentials>div{padding:12px}.e-essentials>div:nth-child(2){grid-row:2;grid-column:1/-1;border-top:1px solid var(--e-line);border-right:0}.e-essentials>div:nth-child(3){grid-row:1;grid-column:2}.e-jumps{display:grid;grid-template-columns:1fr 1fr;gap:0 12px;padding-top:6px}.e-jumps a{font-size:.875rem}.e-layout{padding-top:22px;gap:24px}.e-questions{grid-template-columns:1fr;gap:8px}.e-question{padding:13px 16px;display:grid;grid-template-columns:80px minmax(0,1fr);gap:4px 12px;border-top:1px solid var(--e-line);border-left:3px solid var(--e-blue)}.e-question-label{grid-row:1;align-self:center}.e-question h3{grid-column:2}.e-question>p,.e-question>details{grid-column:2}.e-question details{margin:0}.n-civic #main .e-question summary{min-height:40px}.e-fiscal-summary{grid-template-columns:minmax(0,1fr) auto 16px;gap:6px 10px;padding:13px 14px}.e-issue{grid-column:1;grid-row:1}.e-measure{grid-column:1;grid-row:2}.e-value{grid-column:2;grid-row:1/span 2;max-width:130px;font-size:1.0625rem}.e-plus{grid-column:3;grid-row:1/span 2}.e-fiscal-detail{padding:0 14px 14px}.e-resource-links{display:block}.e-section-heading{gap:10px}.n-civic #main h2{font-size:1.375rem}.e-sidebar{padding:18px}.e-corrections{gap:12px 16px}}
  @media(max-width:370px){.e-question{display:flex;gap:6px}.e-value{max-width:98px}.e-section-heading{align-items:start}.e-count{white-space:normal;text-align:right}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  @media print{.n-civic .n-head,.n-civic .n-foot,.n-civic .e-jumps{display:none}.e-layout{display:block}.e-sidebar{margin-top:24px}.n-civic details::details-content{content-visibility:visible;height:auto}.n-civic details>*{display:block!important}.e-question,.e-fiscal-list>li{break-inside:avoid}.e-plus{display:none}.n-civic #main a{color:inherit}}
---
<section class="e-hero" aria-labelledby="title-h">
<div class="n-wrap">
  <div class="e-heading">
    <div>
      <p class="e-kicker">2026 election · Independent voter guide</p>
      <h1 class="e-title" id="title-h">Niwot incorporation election</h1>
      <p class="e-intro">What you’re voting on, who may vote, and where to find the official information. A neutral guide to the proposal.</p>
    </div>
    <a class="e-primary" href="https://niwotelection.org/ballot">Read the official ballot <span aria-hidden="true">↗</span></a>
  </div>
  <dl class="e-essentials" aria-label="Election essentials">
    <div><dt>Election day</dt><dd>{{ election.status[0].value }}</dd></div>
    <div><dt>Who may vote</dt><dd>Registered electors within the proposed boundary</dd></div>
    <div><dt>How to vote</dt><dd>{{ election.status[2].value }}</dd></div>
  </dl>
  <p class="e-source-note"><strong>The official ballot language controls.</strong> This page provides plain-language summaries, not the official text.</p>
  <nav class="e-jumps" aria-label="On this page">
    <a href="#ballot">Three ballot questions</a><a href="#fiscal">Taxes &amp; debt</a><a href="#after">What happens next</a><a href="#official">Official resources</a>
  </nav>
</div>
</section>

<div class="n-wrap e-layout">
<div class="e-main">
  <section class="e-section" id="ballot" aria-labelledby="q-h">
    <div class="e-section-heading"><h2 id="q-h">Three ballot questions</h2><span class="e-count">Questions 1–3</span></div>
    <p class="e-section-intro">Three separate decisions. Approval of one does not automatically decide another.</p>
    {% set questionTitles = ['Create a municipality', 'Form a charter commission', 'Elect nine commissioners'] %}
    {% set questionSummaries = ['Whether Niwot should incorporate.', 'Whether nine members should draft a home rule charter.', 'Which candidates should serve on the charter commission.'] %}
    <ol class="e-questions">
    {%- for q in election.questions %}
      <li class="e-question">
        <span class="e-question-label">Question {{ loop.index }}</span>
        <h3>{{ questionTitles[loop.index0] }}</h3>
        <p>{{ questionSummaries[loop.index0] }}</p>
        <details><summary>Read details<span class="e-sr-only">: {{ q.title }}</span></summary><p>{{ q.body }}</p></details>
      </li>
    {%- endfor %}
    </ol>
  </section>

  <section class="e-section" id="fiscal" aria-labelledby="f-h">
    <div class="e-section-heading"><h2 id="f-h">Taxes, revenue &amp; debt</h2><span class="e-count">Issues 1–5</span></div>
    <p class="e-section-intro">Five separate authorizations. Select a measure to read its explanation.</p>
    {% set fiscalTitles = ['Sales & use tax', 'Property tax', 'Marijuana sales tax', 'Retain & spend revenue', 'Transportation debt'] %}
    {% set fiscalNotes = ['Begins January 1, 2028', 'Within the municipal boundary', 'Special sales tax', 'Revenue above applicable limits', 'Up to $28 million total repayment'] %}
    {% set fiscalValues = ['2.5%', '4 mills', '3%', 'Spending', 'Up to $15M'] %}
    {% set fiscalUnits = ['tax rate', 'mill levy', 'tax rate', 'authority', 'debt authorization'] %}
    <ol class="e-fiscal-list">
    {%- for f in election.fiscal %}
      <li><details>
        <summary class="e-fiscal-summary">
          <span class="e-issue">Issue {{ loop.index }}</span>
          <span class="e-measure"><strong>{{ fiscalTitles[loop.index0] }}</strong><small>{{ fiscalNotes[loop.index0] }}</small></span>
          <span class="e-value">{{ fiscalValues[loop.index0] }}<small>{{ fiscalUnits[loop.index0] }}</small></span>
          <span class="e-plus" aria-hidden="true"></span>
        </summary>
        <div class="e-fiscal-detail"><p>{{ f.body }}</p><a href="https://niwotelection.org/ballot">Full wording, conditions &amp; exemptions on the official ballot ↗</a></div>
      </details></li>
    {%- endfor %}
    </ol>
    <p class="e-source-note">Source: <a href="https://niwotelection.org/ballot">Niwot Election Commission</a>. Questions and fiscal issues are numbered separately.</p>
  </section>

  <section class="e-section" id="after" aria-labelledby="a-h">
    <div class="e-section-heading"><h2 id="a-h">What happens next</h2></div>
    <details class="e-disclosure">
      <summary class="e-disclosure-summary"><span>No charter is being approved on November 3.<small>See the process after the incorporation vote.</small></span><span class="e-plus" aria-hidden="true"></span></summary>
      <div class="e-disclosure-body"><ol class="e-next-list">{% for a in election.after %}<li>{{ a.text }}</li>{% endfor %}</ol></div>
    </details>
  </section>

  <section class="e-corrections" aria-labelledby="corr-h">
    <h2 id="corr-h">Corrections</h2><a href="/plan-a-visit/#contact">Report a correction</a><a href="/our-story/#sources">Editorial standards</a>
    <p>Claims must be supported by filed documents or official publications. Corrections are published with their date and a note explaining what changed.</p>
  </section>
</div>

<aside class="e-sidebar" id="official" aria-labelledby="o-h">
  <h2 id="o-h">Official resources</h2>
  <p class="e-sidebar-intro">Election information from the Commission and Boulder County.</p>
  <ul class="e-resource-links">{% for o in election.official %}<li><a href="{{ o.href }}" rel="noopener">{{ o.label }}<span aria-hidden="true">↗</span></a></li>{% endfor %}</ul>
  <div class="e-verification"><strong>Last verified {{ site.verified }}</strong>The Commission’s printer’s-proof review is scheduled for September 11, 2026. Re-check the <a href="https://niwotelection.org/ballot">official ballot page</a> after that review.</div>
  <details class="e-disclosure">
    <summary class="e-disclosure-summary"><span>Election administration</span><span class="e-plus" aria-hidden="true"></span></summary>
    <div class="e-disclosure-body"><dl class="e-meta">{% for s in election.status %}<div><dt>{{ s.label }} — {{ s.value }}</dt><dd>{{ s.note }}</dd></div>{% endfor %}</dl><p>This guide is not an election authority. Where its summaries differ from the Commission’s official text, the official text controls.</p></div>
  </details>
  <details class="e-disclosure">
    <summary class="e-disclosure-summary"><span>Campaign perspectives<small>Advocacy, not official election information</small></span><span class="e-plus" aria-hidden="true"></span></summary>
    <div class="e-disclosure-body"><p>These organizations campaign on the question and publish their own analysis.</p><ul class="e-resource-links">{% for c in election.campaigns %}<li><a href="{{ c.href }}" rel="noopener">{{ c.label }}<span aria-hidden="true">↗</span></a></li>{% endfor %}</ul></div>
  </details>
</aside>
</div>
