  .e-sidebar .e-disclosure{margin-top:16px;border:0;border-top:1px solid var(--e-line)}
  .e-sidebar .e-disclosure-summary{padding:14px 0;font-size:.9375rem}
  .e-sidebar .e-disclosure-body{padding:0 0 14px;font-size:.9375rem}
  .e-meta{margin:0}
  .e-meta>div+div{margin-top:10px}
  .e-meta dt{font-weight:600}
  .e-meta dd{margin:2px 0 0;color:var(--e-muted)}
