<section class="n-bg-green n-pad" id="contact" aria-labelledby="contact-h">
<div class="n-wrap">
<div class="n-g2">
<div>
<div class="n-label">Contribute</div>
<h2 class="n-h2" id="contact-h" style="margin-top:12px;max-width:20ch">Add a listing, an event, or a correction</h2>
<p class="n-body" style="margin:16px 0 0;max-width:54ch;color:var(--n-paper)">Business owners, event organizers and residents keep this guide accurate. Send yours and it goes in with the date it was verified.</p>
<form data-contact-form method="post" action="/api/contact" style="display:grid;gap:18px;max-width:560px;margin-top:24px">
<div class="n-sr" aria-hidden="true">
<label for="v-company">Leave this field empty</label>
<input id="v-company" name="company" type="text" tabindex="-1" autocomplete="off">
</div>
<div>
<label class="n-label" for="v-kind" style="color:var(--n-gold-lt)">What is this?</label>
<select class="n-field" id="v-kind" name="kind">
<option>Business listing</option>
<option>Event listing</option>
<option>Public art inventory</option>
<option>Accessibility correction</option>
<option>Correction to this guide</option>
<option>Something else</option>
</select>
</div>
<div>
<label class="n-label" for="v-name" style="color:var(--n-gold-lt)">Name of the business, event or page</label>
<input class="n-field" id="v-name" name="subject" type="text" required placeholder="e.g. Explore &#8212; public art">
</div>
<div>
<label class="n-label" for="v-detail" style="color:var(--n-gold-lt)">Details</label>
<textarea class="n-field" id="v-detail" name="detail" rows="5" required></textarea>
</div>
<div>
<label class="n-label" for="v-src" style="color:var(--n-gold-lt)">Link to your own page or the source</label>
<input class="n-field" id="v-src" name="source" type="url" inputmode="url" autocomplete="url" placeholder="https://">
</div>
<div>
<label class="n-label" for="v-email" style="color:var(--n-gold-lt)">Your email</label>
<input class="n-field" id="v-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="Used only to reply about this submission">
</div>
<div style="display:flex;flex-wrap:wrap;gap:16px;align-items:center">
<button class="n-btn" type="submit" style="cursor:pointer;font-family:inherit">Send submission</button>
</div>
<p class="n-small" style="margin:0;max-width:54ch;color:var(--n-sage-lt)">Your email is optional and is used only to reply about this submission. Sending a correction does not sign you up for notices. <a href="/privacy/">How submissions are handled</a>.</p>
</form>
<template data-form-success><p role="status" style="margin:24px 0 0;padding-top:16px;border-top:3px solid var(--n-gold-lt);max-width:54ch;color:var(--n-white)">Thank you &#8212; your submission has been sent. It goes in with the date it was verified.</p></template>
<template data-form-unavailable><p role="status" data-message style="margin:24px 0 0;padding-top:16px;border-top:3px solid var(--n-gold-lt);max-width:54ch;color:var(--n-white)">This form is not connected yet, so nothing was sent. Use the direct contacts listed beside this form &#8212; each one is the responsible body for its subject.</p></template>
</div>
<div>
<div class="n-label">Go direct instead</div>
<p class="n-body" style="margin:12px 0 0;max-width:42ch;color:var(--n-paper)">For anything official &#8212; permits, roads, ballots, water &#8212; the responsible body is the only reliable contact. None of the bodies below runs this website.</p>
<div style="margin-top:20px">
{%- if site.editor.email %}
<div style="display:grid;gap:4px;padding:14px 0;border-top:1px solid rgba(158,173,152,.35)">
<span class="n-label n-label--quiet" style="color:var(--n-sage-lt)">This guide&#8217;s editor{% if site.editor.name %} &#8212; {{ site.editor.name }}{% endif %}</span>
<a class="n-link" data-editor-email href="mailto:{{ site.editor.email }}" style="justify-self:start;text-transform:none;letter-spacing:0">{{ site.editor.email }}</a>
</div>
{%- endif %}
{%- for d in direct %}
