<span class="n-sr" aria-hidden="true"><label for="nl-company">Leave this field empty</label><input id="nl-company" name="company" type="text" tabindex="-1" autocomplete="off"></span>
<label class="n-sr" for="nl-email">Your email address</label>
<input id="nl-email" name="email" type="email" required placeholder="you@example.com" style="flex:1 1 220px;min-width:0;padding:14px;background:var(--n-white);border:2px solid var(--n-white);font:inherit;font-size:1rem;color:var(--n-ink)">
